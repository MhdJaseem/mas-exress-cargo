{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/air-freight.html",
      "destination": "/air-freight",
      "permanent": true
    },
    {
      "source": "/sea-freight.html",
      "destination": "/sea-freight",
      "permanent": true
    },
    {
      "source": "/gcc-road-transport.html",
      "destination": "/gcc-road-transport",
      "permanent": true
    },
    {
      "source": "/warehousing.html",
      "destination": "/warehousing",
      "permanent": true
    },
    {
      "source": "/customs-clearance.html",
      "destination": "/customs-clearance",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/our-team.html",
      "destination": "/our-team",
      "permanent": true
    },
    {
      "source": "/our-branches.html",
      "destination": "/our-branches",
      "permanent": true
    },
    {
      "source": "/careers.html",
      "destination": "/careers",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
